# =============================================================================
# PDV Web — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de iniciar
# =============================================================================

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://pdv_user:pdv_password@localhost:5432/pdv_web?schema=public"

# Autenticação (JWT)
JWT_SECRET="sua-chave-secreta-jwt-minimo-32-caracteres"
JWT_EXPIRES_IN="15m"          # Access token expira em 15 minutos
JWT_REFRESH_SECRET="sua-chave-secreta-refresh-token"
JWT_REFRESH_EXPIRES_IN="7d"   # Refresh token expira em 7 dias

# NextAuth (se usar next-auth para login social ou padrão)
NEXTAUTH_SECRET="sua-chave-secreta-nextauth"
NEXTAUTH_URL="http://localhost:3000"

# Aplicação
NODE_ENV="development"
PORT=3000

# Pagamentos (gateway real — substituir o mock do PDVStore)
# PAGSEGURO_TOKEN=""
# MERCADO_PAGO_ACCESS_TOKEN=""
# STRIPE_SECRET_KEY=""

# Redis (opcional — cache de produtos e sessões)
REDIS_URL="redis://localhost:6379"
