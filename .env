# =============================================================================
# PDV Web — Variáveis de Ambiente (Desenvolvimento)
# =============================================================================

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://pdv_user:pdv_password@localhost:5432/pdv_web?schema=public"

# Autenticação (JWT)
JWT_SECRET="pdv-web-jwt-secret-de-desenvolvimento-minimo-32-caracteres"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="pdv-web-refresh-secret-de-desenvolvimento-minimo-32-caracteres"
JWT_REFRESH_EXPIRES_IN="7d"

# NextAuth
NEXTAUTH_SECRET="pdv-web-nextauth-secret-de-desenvolvimento"
NEXTAUTH_URL="http://localhost:3000"

# Aplicação
NODE_ENV="development"
PORT=3000

# Redis (opcional)
REDIS_URL="redis://localhost:6379"
